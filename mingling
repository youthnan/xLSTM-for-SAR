1) 主训练命令（推荐先跑这个）

cd /root/xLSTM
python train_pi_xlstm.py \
  --mat_path PPTR_TrainDataset_1000.mat \
  --batch_size 4 \
  --epochs 100 \
  --lr 1e-3 \
  --hidden_dim 64 \
  --num_blocks 2 \
  --num_heads 4 \
  --weight_decay 1e-4 \
  --lambda_smooth 0.1 \
  --lambda_rcm_max 0.5 \
  --rcm_warmup_start 20 \
  --rcm_warmup_end 50 \
  --scheduler_step_size 20 \
  --scheduler_gamma 0.5 \
  --checkpoint_every 10 \
  --param_report_every 10 \
  --run_name v1

  2) 后台运行（推荐，免得 SSH 断了训练就挂）
cd /root/xLSTM
nohup python -u train_pi_xlstm.py \
  --mat_path PPTR_TrainDataset_1000.mat \
  --batch_size 4 --epochs 100 --lr 1e-3 \
  --rcm_warmup_start 20 --rcm_warmup_end 50 --lambda_rcm_max 0.5 \
  --checkpoint_every 10 --run_name v1 \
  > run/v1.log 2>&1 &
echo "pid=$!"
tail -f run/v1.log


3) 烟雾自检（先跑这个 5 分钟内确认环境通畅）
cd /root/xLSTM
python train_pi_xlstm.py \
  --mat_path PPTR_TrainDataset_50.mat \
  --batch_size 2 --epochs 3 --hidden_dim 32 \
  --rcm_warmup_start 1 --rcm_warmup_end 2 \
  --checkpoint_every 1 --run_name smoke


  5) 训练完后做评估
cd /root/xLSTM
LATEST=$(ls -td run/*v1* | head -1)/weights/latest.pt
echo "checkpoint: $LATEST"
python eval_pi_xlstm.py \
  --checkpoint "$LATEST" \
  --mat_path PPTR_TrainDataset_1000.mat \
  --batch_size 4 \
  --json_out eval_v1.json

  python eval_pi_xlstm.py \
  --checkpoint "$LATEST" \
  --mat_path PPTR_TrainDataset_1000.mat \
  --batch_size 4 \
  --save_p_fix run/v1_p_fix.mat \
  --also_save_delta


